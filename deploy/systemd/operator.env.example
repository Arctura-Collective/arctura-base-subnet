# Store the deployed copy at ~/.config/arctura-base-subnet.env with mode 0600.
ARCTURA_REPO=/absolute/path/to/arctura-base-subnet
ARCTURA_PYTHON=/absolute/path/to/venv/bin/python

BASE_RPC_URL=https://mainnet.base.org
BT_NETWORK=test
BT_NETUID=505
BT_VALIDATOR_WALLET=arctura_val
BT_MINER_WALLET=arctura_miner
BT_DEFAULT_HOTKEY=default
MINER_AXON_PORT=8191
VALIDATOR_TIMEOUT=30
VALIDATOR_TEMPO=360
ARCTURA_ENERGY_TAG=unknown
