{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [],
          "type": "dashboard"
        },
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "Launch portal",
      "tooltip": "Open the public launch portal",
      "type": "link",
      "url": "https://arctura-collective.github.io/arctura-base-subnet/"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "BLOCKED"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "READY"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "arctura_evidence_gate_ok",
          "legendFormat": "Evidence gate",
          "refId": "A"
        }
      ],
      "title": "Launch Gate",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "arctura_evidence_elapsed_hours",
          "legendFormat": "Elapsed hours",
          "refId": "A"
        }
      ],
      "title": "Evidence Window Hours",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "arctura_evidence_check_pass",
          "format": "table",
          "instant": true,
          "legendFormat": "{{check}}",
          "refId": "A"
        }
      ],
      "title": "Evidence Checks",
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 4,
      "targets": [
        {
          "expr": "arctura_health_passes_total",
          "legendFormat": "Health passes",
          "refId": "A"
        },
        {
          "expr": "arctura_attestations_total",
          "legendFormat": "Attestations",
          "refId": "B"
        },
        {
          "expr": "arctura_weight_commits_total",
          "legendFormat": "Weight commits",
          "refId": "C"
        }
      ],
      "title": "Evidence Counters",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 5,
      "targets": [
        {
          "expr": "arctura_service_active{service=~\"arctura-(miner|validator)\"}",
          "legendFormat": "{{service}} active",
          "refId": "A"
        },
        {
          "expr": "arctura_service_restarts_total{service=~\"arctura-(miner|validator)\"}",
          "legendFormat": "{{service}} restarts",
          "refId": "B"
        }
      ],
      "title": "Neuron Service Health",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "id": 6,
      "targets": [
        {
          "expr": "arctura_validator_cycle_latest_seconds",
          "legendFormat": "Latest validator cycle",
          "refId": "A"
        },
        {
          "expr": "arctura_validator_cycle_max_seconds",
          "legendFormat": "Max validator cycle",
          "refId": "B"
        }
      ],
      "title": "Validator Cycle Latency",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "arctura",
    "bittensor",
    "launch-readiness"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
